# Фрагмент конфігурації ядра ЛР 11: накладається поверх
# board/qemu/x86_64/linux.config (BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES).

# Те саме, що в ЛР 10, але версія -lab11: модулі ЛР 10 цьому ядру чужі.
CONFIG_LOCALVERSION="-lab11"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK_TIME=y

# TODO 1. Допишіть рядки CONFIG_...=y, щоб ядро вміло:
